{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdr.local/schemas/scenario-result.schema.json",
  "title": "SDR scenario result",
  "description": "Completed model results preserving user-facing inputs, resolved model inputs, and all outcome datasets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resultId",
    "requestId",
    "completedAt",
    "status",
    "modelVersion",
    "sharedSettings",
    "outputSelection",
    "referenceScenarioId",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "resultId": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "const": "completed"
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1
    },
    "sharedSettings": {
      "$ref": "#/$defs/sharedSettings"
    },
    "outputSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "const": "all_outcomes"
        }
      }
    },
    "referenceScenarioId": {
      "type": "string",
      "description": "The scenarioId of the first scenario in the ordered scenarios array."
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/scenarioResult"
      }
    }
  },
  "$defs": {
    "sharedSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "countyId",
        "numberOfRuns",
        "numberOfMonths",
        "randomSeedStrategy",
        "confidenceIntervalMethod"
      ],
      "properties": {
        "countyId": { "type": "string", "minLength": 1 },
        "numberOfRuns": { "type": "integer", "minimum": 1 },
        "numberOfMonths": { "type": "integer", "minimum": 1 },
        "randomSeedStrategy": { "const": "matched_across_scenarios" },
        "randomSeed": { "type": ["integer", "null"] },
        "confidenceIntervalMethod": {
          "enum": [
            "mean_per_run_poisson_bounds",
            "empirical_run_quantiles"
          ]
        }
      }
    },
    "scenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "revision",
        "label",
        "scenarioRole",
        "planningInputs",
        "resolvedModelInputs",
        "datasets"
      ],
      "properties": {
        "scenarioId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "scenarioRole": {
          "enum": ["reference", "comparison"]
        },
        "planningInputs": {
          "type": "object",
          "additionalProperties": true
        },
        "resolvedModelInputs": {
          "type": "object",
          "description": "Validated, exact inputs used for this model run. These are inspectable but not directly editable in the initial frontend.",
          "required": ["flags", "E", "S", "HSS", "model"],
          "properties": {
            "flags": { "type": "object", "additionalProperties": true },
            "E": { "type": "object", "additionalProperties": true },
            "S": { "type": "object", "additionalProperties": true },
            "HSS": { "type": "object", "additionalProperties": true },
            "model": { "type": "object", "additionalProperties": true }
          },
          "additionalProperties": true
        },
        "datasets": {
          "type": "array",
          "description": "All outcome datasets produced for this scenario, in catalog-driven order where applicable.",
          "items": {
            "$ref": "#/$defs/dataset"
          }
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["datasetId", "rowCount", "columns", "rows"],
      "properties": {
        "datasetId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "label": {
          "type": "string"
        },
        "rowCount": {
          "type": "integer",
          "minimum": 0
        },
        "columns": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
